{
  "name": "signal-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "pulse:compute": "node packages/pulse-core/dist/cli.js",
    "oracle:publish": "node packages/pulse-oracle/dist/cli.js",
    "forge:dev": "npm run dev -w @signal/forge",
    "dashboard:dev": "npm run dev -w @signal/dashboard",
    "token:deploy": "node packages/token/dist/deploy.js",
    "ritual:run": "node packages/ritual/dist/cli.js",
    "stealth:generate": "node packages/stealth/dist/cli.js"
  }
}
